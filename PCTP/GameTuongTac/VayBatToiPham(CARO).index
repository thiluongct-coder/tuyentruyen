
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Minigame: Vây Bắt Tội Phạm (Caro Nối 5 - AI Chủ Động)</title>
    <style>
        :root {
            --bg-color: #f0f4f8;
            --panel-bg: #ffffff;
            --primary-color: #0284c7; /* Xanh cảnh sát */
            --danger-color: #dc2626;  /* Đỏ tội phạm */
            --text-color: #1e293b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: manipulation; 
        }

        body {
            background: linear-gradient(135deg, #e0f2fe, #f8fafc);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 10px;
        }

        .game-container {
            width: 100%;
            max-width: 500px;
            background: var(--panel-bg);
            padding: 15px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border: 1px solid rgba(2, 132, 199, 0.2);
            text-align: center;
        }

        h1 {
            font-size: 1.3rem;
            color: var(--primary-color);
            margin-bottom: 3px;
            text-transform: uppercase;
        }

        .subtitle {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 8px;
        }

        /* Nút ẩn/hiện cốt truyện và hướng dẫn */
        .story-toggle-btn {
            background: none;
            border: none;
            color: var(--primary-color);
            font-size: 0.85rem;
            cursor: pointer;
            text-decoration: underline;
            margin-bottom: 10px;
            display: inline-block;
        }

        /* Khung cốt truyện ẩn hiện */
        .story-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 12px;
            text-align: left;
            font-size: 0.82rem;
            color: #475569;
            line-height: 1.4;
            display: none;
        }

        .story-box.show {
            display: block;
        }

        .story-box h3 {
            color: var(--primary-color);
            font-size: 0.88rem;
            margin-bottom: 4px;
        }

        .status-bar {
            font-size: 1rem;
            font-weight: bold;
            margin-bottom: 12px;
            padding: 8px;
            background: #f1f5f9;
            border-radius: 8px;
            color: #334155;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(10, 1fr);
            gap: 3px;
            background: #cbd5e1;
            padding: 6px;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .cell {
            aspect-ratio: 1;
            background: #ffffff;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            user-select: none;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        }

        .cell:hover {
            background: #f8fafc;
        }

        .cell:active {
            transform: scale(0.9);
        }

        .restart-btn {
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: bold;
            color: #ffffff;
            background: linear-gradient(135deg, var(--primary-color), #0369a1);
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.3);
            text-transform: uppercase;
            transition: all 0.2s ease;
            display: none;
            margin: 0 auto;
        }

        .restart-btn:hover {
            filter: brightness(1.1);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <div class="game-container">
        <h1>Vây Bắt Tội Phạm (Caro 10x10)</h1>
        <div class="subtitle">Đối tượng đang tìm cách bỏ trốn, bạn hãy chỉ đạo lực lượng truy bắt đối tượng để xử lý</div>
        
        <!-- Tab ẩn hiện cốt truyện & hướng dẫn -->
        <button class="story-toggle-btn" onclick="toggleStory()" id="toggle-btn">📖 Xem Nhiệm Vụ & Hồ Sơ Truy Nã</button>
        <div class="story-box" id="story-box">
            <h3>Hồ Sơ Đặc Biệt: Chuyên Án X</h3>
            <p><strong>Cốt truyện:</strong> Một tội phạm nguy hiểm đang lợi dụng địa bàn khu phố để ẩn náu và tìm đường tẩu thoát. Hắn cực kỳ ranh mãnh, liên tục tìm cách phá vỡ vòng vây để mở đường máu.</p>
            <p style="margin-top: 4px;"><strong>Nhiệm vụ:</strong> Bạn là chỉ huy lực lượng công an. Hãy triển khai lực lượng (👮‍) chặn đầu, khóa đuôi và tạo thành chuỗi 5 ô liên tiếp trước để bắt gọn đối tượng (👤) trước khi hắn kịp tẩu thoát!</p>
        </div>
        
        <div class="status-bar" id="status">Lượt của bạn: 👮‍ (Công an)</div>

        <div class="board" id="board"></div>

        <button class="restart-btn" id="restart-btn" onclick="resetGame()">Chơi Lại</button>
    </div>

    <script>
        const BOARD_SIZE = 10;
        const WIN_COUNT = 5;
        let board = Array(BOARD_SIZE * BOARD_SIZE).fill('');
        let isGameActive = true;
        let currentPlayer = 'cop';

        const statusEl = document.getElementById('status');
        const boardEl = document.getElementById('board');
        const restartBtn = document.getElementById('restart-btn');
        const storyBox = document.getElementById('story-box');
        const toggleBtn = document.getElementById('toggle-btn');

        function toggleStory() {
            if (storyBox.classList.contains('show')) {
                storyBox.classList.remove('show');
                toggleBtn.innerText = "📖 Xem Nhiệm Vụ & Hồ Sơ Truy Nã";
            } else {
                storyBox.classList.add('show');
                toggleBtn.innerText = "📖 Đóng Hồ Sơ";
            }
        }

        function initBoard() {
            boardEl.innerHTML = '';
            for (let i = 0; i < BOARD_SIZE * BOARD_SIZE; i++) {
                const cell = document.createElement('div');
                cell.classList.add('cell');
                cell.addEventListener('click', () => makeMove(i));
                boardEl.appendChild(cell);
            }
        }

        function makeMove(index) {
            if (board[index] !== '' || !isGameActive || currentPlayer !== 'cop') return;

            board[index] = 'cop';
            updateBoardUI();
            
            if (checkWin(board, index, 'cop')) {
                statusEl.innerHTML = "🎉 <span style='color: var(--primary-color);'>Bắt gọn đối tượng thành công!</span>";
                endGame();
                return;
            }

            if (board.every(cell => cell !== '')) {
                statusEl.innerText = "🤝 Khu vực an toàn, bất phân thắng bại!";
                endGame();
                return;
            }

            currentPlayer = 'criminal';
            statusEl.innerText = "Đối tượng đang phản công quyết liệt... 👤";
            
            setTimeout(aiMove, 250);
        }

        function aiMove() {
            if (!isGameActive) return;

            let bestMove = findBestAIMove();

            if (bestMove !== -1) {
                board[bestMove] = 'criminal';
                updateBoardUI();

                if (checkWin(board, bestMove, 'criminal')) {
                    statusEl.innerHTML = "❌ <span style='color: var(--danger-color);'>Tội phạm đã tẩu thoát thành công!</span>";
                    endGame();
                    return;
                }

                if (board.every(cell => cell !== '')) {
                    statusEl.innerText = "🤝 Khu vực an toàn, bất phân thắng bại!";
                    endGame();
                    return;
                }
            }

            currentPlayer = 'cop';
            statusEl.innerText = "Lượt của bạn: 👮‍ (Công an)";
        }

        function findBestAIMove() {
            let emptyCells = [];
            board.forEach((val, idx) => { if (val === '') emptyCells.push(idx); });

            if (emptyCells.length === BOARD_SIZE * BOARD_SIZE) {
                return Math.floor(BOARD_SIZE * BOARD_SIZE / 2) + Math.floor(BOARD_SIZE / 2);
            }

            let relevantCells = emptyCells.filter(idx => {
                let r = Math.floor(idx / BOARD_SIZE);
                let c = idx % BOARD_SIZE;
                for (let dr = -2; dr <= 2; dr++) {
                    for (let dc = -2; dc <= 2; dc++) {
                        let nr = r + dr, nc = c + dc;
                        if (nr >= 0 && nr < BOARD_SIZE && nc >= 0 && nc < BOARD_SIZE) {
                            if (board[nr * BOARD_SIZE + nc] !== '') return true;
                        }
                    }
                }
                return false;
            });

            if (relevantCells.length === 0) relevantCells = emptyCells;

            let bestScore = -Infinity;
            let bestMove = relevantCells[0];

            for (let idx of relevantCells) {
                board[idx] = 'criminal';
                if (checkWin(board, idx, 'criminal')) {
                    board[idx] = '';
                    return idx;
                }
                board[idx] = '';

                board[idx] = 'cop';
                if (checkWin(board, idx, 'cop')) {
                    board[idx] = '';
                    return idx;
                }
                board[idx] = '';

                let score = evaluateCell(idx);
                if (score > bestScore) {
                    bestScore = score;
                    bestMove = idx;
                }
            }

            return bestMove;
        }

        function evaluateCell(index) {
            let score = 0;
            const r = Math.floor(index / BOARD_SIZE);
            const c = index % BOARD_SIZE;

            score += getPatternScore(index, 'criminal') * 1.5; 
            score += getPatternScore(index, 'cop') * 1.4;     

            let centerDist = Math.abs(r - BOARD_SIZE/2) + Math.abs(c - BOARD_SIZE/2);
            score += (BOARD_SIZE - centerDist);

            return score;
        }

        function getPatternScore(index, player) {
            const row = Math.floor(index / BOARD_SIZE);
            const col = index % BOARD_SIZE;
            const directions = [{r:0, c:1}, {r:1, c:0}, {r:1, c:1}, {r:1, c:-1}];
            let maxStreakScore = 0;

            for (let dir of directions) {
                let count = 1;
                let openEnds = 0;

                let r = row + dir.r, c = col + dir.c;
                while (r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE) {
                    let val = board[r * BOARD_SIZE + c];
                    if (val === player) {
                        count++;
                    } else {
                        if (val === '') openEnds++;
                        break;
                    }
                    r += dir.r; c += dir.c;
                }

                r = row - dir.r; c = col - dir.c;
                while (r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE) {
                    let val = board[r * BOARD_SIZE + c];
                    if (val === player) {
                        count++;
                    } else {
                        if (val === '') openEnds++;
                        break;
                    }
                    r -= dir.r; c -= dir.c;
                }

                let streakScore = 0;
                if (count >= 4) {
                    streakScore = openEnds > 0 ? 500000 : 50000; 
                } else if (count === 3) {
                    if (openEnds >= 2) streakScore = 20000; 
                    else if (openEnds === 1) streakScore = 2000;
                } else if (count === 2) {
                    if (openEnds >= 2) streakScore = 300;
                }

                if (streakScore > maxStreakScore) maxStreakScore = streakScore;
            }
            return maxStreakScore;
        }

        function checkWin(currentBoard, index, player) {
            const row = Math.floor(index / BOARD_SIZE);
            const col = index % BOARD_SIZE;
            const directions = [{ r: 0, c: 1 }, { r: 1, c: 0 }, { r: 1, c: 1 }, { r: 1, c: -1 }];

            for (let dir of directions) {
                let count = 1;
                let r = row + dir.r, c = col + dir.c;
                while (r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE && currentBoard[r * BOARD_SIZE + c] === player) {
                    count++;
                    r += dir.r; c += dir.c;
                }
                r = row - dir.r; c = col - dir.c;
                while (r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE && currentBoard[r * BOARD_SIZE + c] === player) {
                    count++;
                    r -= dir.r; c -= dir.c;
                }
                if (count >= WIN_COUNT) return true;
            }
            return false;
        }

        function updateBoardUI() {
            const cells = boardEl.children;
            for (let i = 0; i < board.length; i++) {
                if (board[i] === 'cop') {
                    cells[i].innerText = '👮‍';
                } else if (board[i] === 'criminal') {
                    cells[i].innerText = '👤';
                } else {
                    cells[i].innerText = '';
                }
            }
        }

        function endGame() {
            isGameActive = false;
            restartBtn.style.display = 'block';
        }

        function resetGame() {
            board = Array(BOARD_SIZE * BOARD_SIZE).fill('');
            isGameActive = true;
            currentPlayer = 'cop';
            statusEl.innerText = "Lượt của bạn: 👮‍ (Công an)";
            restartBtn.style.display = 'none';
            updateBoardUI();
        }

        initBoard();
    </script>
</body>
</html>
